node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out
build

# Template media is committed (#50): public/audio/<kit>/ and public/ident/ are
# tracked, as long as each file is small and ours. What stays out is private
# or large; scripts/private-media.ts lists it with where it comes from.
# Copyrighted music (the weekly lineup beds) and local test audio:
public/audio/private/
# loose tracks left directly in public/audio/ (the old pick-track, test songs)
public/audio/*.mp3
public/audio/*.wav
public/audio/*.flac
public/audio/*.aif*
public/audio/*.m4a
# Denzo's old local copy of the Fuse-Drums clip (#49); the committed clip
# lives under public/ident/audio/fusedrums/
public/audio/fuse-drums/

# Working files for the session video edit (large intermediates)
work/
public/session/

# Large media and per-machine state — local only
public/fort-riddim/
public/reel/
# Reel definitions for real interviews quote the transcript (#55): keep them next to
# the episode (sesh-out/reel/). Only the made-up example is committed.
*.reel.json
!src/reel/data/example.reel.json
public/artists/
posters/state.json
weekly/state.json

# longform/ (sesh-edit, Python + uv): venv, caches, build output, work dirs
longform/.venv/
longform/dist/
longform/work/
longform/out/
# the sesh-edit intro, built from src/ident/Fuse by `bun run render:intro` (#38)
longform/src/sesh_edit/assets/intro/fuse-16x9.*
longform/models/
longform/bin/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# sesh-batch (#47): manifests hold Dropbox share links, status files and outputs name
# private recordings. Keep manifests outside the repo anyway; these catch strays.
batch*.json
*.batch.json
*.status.json
*.status.json.wlock
batch*.lock
*.batch.lock
*.part
*.srt
*.decisions.json
*.review.txt
*.work/
*.upscale-work/

# Share bundles (#60) name the guest, quote the interview and may hold a Dropbox link:
# they live in the shared Dropbox folder, never here. share.local.json is per computer.
job.json
*.shared-input.json
share.local.json
rebuild/
media/inserts/
media/intro/
media/public/
